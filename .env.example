# Database
DATABASE_URL=postgresql://user:password@host:5432/prism

# GitHub OAuth — create at github.com/settings/developers → OAuth Apps
# Callback URL: https://your-app.com/api/auth/callback/github
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret

# AI — read automatically by the GitAgent SDK
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false

# App URL — must match in both vars
NEXTAUTH_URL=https://your-app.com
NEXT_PUBLIC_APP_URL=https://your-app.com

# NextAuth session secret — generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret

# AES-256-GCM key for encrypting tokens in DB — generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# Local agent path (for skills/knowledge docs — not for soul/rules, those are in DB)
AGENT_REPO_PATH=./src/agent
