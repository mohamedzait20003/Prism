# Database connection
# PostgreSQL connection string (Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/prism

# GitHub
# Personal access token with repo scope (read diffs, post review comments)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Secret used to verify incoming webhook payloads from GitHub
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# The repository where agent/ lives — required when IS_DEVELOPMENT=false
# Format: owner/repo  (e.g. acme/prism)
GITHUB_REPO=owner/repo

# AI
# Read automatically by the @open-gitagent/gitagent SDK
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# Agent
# Path to the agent/ directory (relative or absolute)
# Only used when IS_DEVELOPMENT=true
AGENT_REPO_PATH=./agent

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment flag
# true  → use local filesystem + simple-git (local dev)
# false → use GitHub API via Octokit (Vercel / Render / any read-only FS host)
IS_DEVELOPMENT=true

# ── Authentication (NextAuth) ─────────────────────────────────────────────────
# Full public URL of the app (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app

# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret

# GitHub OAuth App credentials
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: https://your-app.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
